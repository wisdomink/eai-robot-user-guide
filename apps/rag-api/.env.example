# === OpenAI (required) ===
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-5.4-mini

# direct: raw retrieval (default); agent: legacy domain-agent retrieval
CHAT_RETRIEVAL_MODE=direct
RETRIEVAL_MAX_RESULTS=6
RETRIEVAL_MAX_CHARS_PER_PASS=18000

# Shared manuals: keep legacy until every product release has been verified.
MANUALS_INDEX_MODE=legacy
OPENAI_VECTOR_STORE_MANUALS_ID=
# Default: apps/rag-api/data/manuals-releases.json; use an absolute persistent path in production.
# MANUALS_RELEASE_MANIFEST=/app/rag-api/data/manuals-releases.json


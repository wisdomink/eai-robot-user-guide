# === Smart Email Alerts ===
ALERT_ENABLED=true
ALERT_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USE_TLS=true
ALERT_SMTP_USER=YOUR_AWS_SES_SMTP_USER
ALERT_SMTP_PASSWORD=YOUR_AWS_SES_SMTP_PASSWORD
ALERT_FROM_EMAIL=alerts@ff.com
ALERT_TO_EMAILS=xin.zhang@ff.com
ALERT_COOLDOWN_SECONDS=300
ALERT_CONTEXT_LINES=50
ALERT_LEVEL=ERROR
ALERT_APP_NAME="EAI Robot"
ALERT_DIGEST_INTERVAL=3600

# === Public URL (for ChatKit image display) ===
PUBLIC_BASE_URL=https://localhost:5173


LEADS_FORWARD_URL='https://03462318fbe5e3faba99496187fc70.17.environment.api.powerplatform.com:443/powerautomate/automations/direct/workflows/f182931171da43889823164070539290/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=zf-V76r6UeUrbzvk_ePp417mrbNLX4fuDvLGhaZuL3A'

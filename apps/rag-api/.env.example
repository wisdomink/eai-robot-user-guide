# === OpenAI (required) ===
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-5.4-mini
# Optional: SDK default connect=5s — raise if you see httpx.ConnectTimeout to api.openai.com
# OPENAI_HTTP_CONNECT_TIMEOUT=30
# OPENAI_HTTP_READ_TIMEOUT=600
# Multi-RAG retrieval loop: run independent vector-store passes in parallel.
# LOOP_PASS_MAX_CONCURRENCY=4
# LOOP_PASS_TIMEOUT_SECONDS=240
# LOOP_PROGRESS_HEARTBEAT_SECONDS=20

# === Vector Stores (per-product) ===
OPENAI_VECTOR_STORE_MASTER_ULTRA_ID=vs_xxx
OPENAI_VECTOR_STORE_FUTURIST_ULTRA_ID=vs_xxx
OPENAI_VECTOR_STORE_AEGIS_ULTRA_ID=vs_xxx
OPENAI_VECTOR_STORE_AEGIS_EDU_ID=vs_xxx
OPENAI_VECTOR_STORE_FF91_ID=vs_xxx
OPENAI_VECTOR_STORE_ROBOT_ALL_ID=vs_xxx

# === Logging ===
# LOG_DIR=/app/rag-api/logs
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=10485760       # 10 MB per file
# LOG_BACKUP_COUNT=5           # keep 5 rotated backups

# === Smart Email Alerts (optional — rule-based error classification) ===
# Errors are classified into 4 categories:
#   alert   → Critical: send email immediately (auth, service down, OOM)
#   burst   → Important: only alert after N repeated failures in a window
#   suppress→ Known non-critical: silently ignore (warmup, 404s)
#   digest  → Default: accumulate and send periodic summary
ALERT_ENABLED=false
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USE_TLS=true
# ALERT_SMTP_USER=your-email@gmail.com
# ALERT_SMTP_PASSWORD=your-app-password
# ALERT_FROM_EMAIL=alerts@your-domain.com
# ALERT_TO_EMAILS=dev1@your-domain.com,dev2@your-domain.com
# ALERT_COOLDOWN_SECONDS=300   # same error suppressed for 5 minutes
# ALERT_CONTEXT_LINES=50       # recent log lines included in alert
# ALERT_LEVEL=ERROR            # minimum level: ERROR or CRITICAL
# ALERT_APP_NAME=EAI Robot
# ALERT_DIGEST_INTERVAL=3600   # digest summary email every 1 hour

# === Public URL (required for ChatKit image display and manual page links) ===
# ChatKit iframe hosted on cdn.platform.openai.com can't resolve relative
# image paths. This value is also used to expand product manual source links
# into full page URLs shown in the final "Sources" section.
PUBLIC_BASE_URL=https://your-domain.com

# === Leads forwarding (optional) ===
# When configured, each saved lead is also POSTed to an external webhook.
# Example payload:
# {"firstName":"Evan","lastName":"Liu","phone":"6266668888","email":"evanliu@ff.com","source":"AI Chat"}
# LEADS_FORWARD_URL='https://03462318fbe5e3faba99496187fc70.17.environment.api.powerplatform.com:443/powerautomate/automations/direct/workflows/f182931171da43889823164070539290/triggers/manual/paths/invoke?api-version=1&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=zf-V76r6UeUrbzvk_ePp417mrbNLX4fuDvLGhaZuL3A'
# LEADS_FORWARD_TIMEOUT=10
# LEADS_FORWARD_SOURCE=AI Chat

# === Homepage prompts persistence ===
# Dev/local: keep file backend so repo JSON is the source of truth.
# Production on AWS: prefer DynamoDB. If needed, run sync_homepage_prompts.py locally
# after deployment to push homepage_prompts.json to the remote service APIs.
# HOMEPAGE_PROMPTS_BACKEND=file
# HOMEPAGE_PROMPTS_DATA_PATH=/app/rag-api/data/homepage_prompts.json
# HOMEPAGE_PROMPTS_DDB_TABLE=eai-robot-homepage-prompts

# === Fast answers: preset FAQ + repeated-question memory ===
# Preset FAQ hits return immediately before RAG, then still run post-answer
# recommendation / lead-capture triage.
# FAST_ANSWER_ENABLED=true
# Comma-separated files; keep CN and EN in separate markdown files.
# PRESET_FAQ_PATHS=/app/rag-api/fast-answer/ff_assist_preset_faq_cn.md,/app/rag-api/fast-answer/ff_assist_preset_faq_en.md
# ANSWER_MEMORY_ENABLED=true
# ANSWER_MEMORY_DATA_PATH=/app/rag-api/data/answer_memory.jsonl
# ANSWER_MEMORY_MAX_RECORDS=2000
# PRESET_FAQ_FUZZY_THRESHOLD=0.82
# ANSWER_MEMORY_FUZZY_THRESHOLD=0.90

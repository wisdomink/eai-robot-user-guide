{
  "openapi": "3.1.0",
  "info": {
    "title": "FF Robot ChatKit Service",
    "version": "3.2.0"
  },
  "paths": {
    "/api/chatkit": {
      "post": {
        "summary": "Chatkit Endpoint",
        "description": "Self-hosted ChatKit protocol endpoint (used when CHAT_MODE=backend).",
        "operationId": "chatkit_endpoint_api_chatkit_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "summary": "Search Endpoint",
        "description": "Semantic search via OpenAI Vector Store Search API.",
        "operationId": "search_endpoint_api_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Search query",
              "default": "",
              "title": "Q"
            },
            "description": "Search query"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "Max results",
              "default": 10,
              "title": "Limit"
            },
            "description": "Max results"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat-history": {
      "get": {
        "summary": "List Threads",
        "description": "List all conversation threads (newest first by default).",
        "operationId": "list_threads_api_chat_history_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Max threads",
              "default": 50,
              "title": "Limit"
            },
            "description": "Max threads"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Sort order: asc or desc",
              "default": "desc",
              "title": "Order"
            },
            "description": "Sort order: asc or desc"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/post-lead": {
      "post": {
        "summary": "Create Lead",
        "description": "Persist one lead row to local jsonl file.",
        "operationId": "create_lead_api_post_lead_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LeadCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/get-leads": {
      "get": {
        "summary": "List Leads",
        "description": "Read all leads from local jsonl file (newest first).",
        "operationId": "list_leads_api_get_leads_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/chat-history/{thread_id}": {
      "get": {
        "summary": "Get Thread Detail",
        "description": "Get all messages in a specific thread.",
        "operationId": "get_thread_detail_api_chat_history__thread_id__get",
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Thread Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/logs": {
      "get": {
        "summary": "List Logs",
        "description": "List all available log types with links.",
        "operationId": "list_logs_api_logs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/logs/all": {
      "get": {
        "summary": "Read All Logs",
        "description": "Read the last N lines from every log file, merged and sorted by timestamp.",
        "operationId": "read_all_logs_api_logs_all_get",
        "parameters": [
          {
            "name": "tail",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5000,
              "minimum": 1,
              "description": "Number of lines per log file",
              "default": 200,
              "title": "Tail"
            },
            "description": "Number of lines per log file"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/logs/{log_name}": {
      "get": {
        "summary": "Read Log",
        "description": "Read the last N lines of a log file. Persists across container restarts.",
        "operationId": "read_log_api_logs__log_name__get",
        "parameters": [
          {
            "name": "log_name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Log Name"
            }
          },
          {
            "name": "tail",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5000,
              "minimum": 1,
              "description": "Number of lines from the end",
              "default": 200,
              "title": "Tail"
            },
            "description": "Number of lines from the end"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LeadCreateRequest": {
        "properties": {
          "product": {
            "type": "string",
            "title": "Product",
            "description": "Product ID",
            "default": ""
          },
          "firstName": {
            "type": "string",
            "title": "Firstname",
            "description": "User first name",
            "default": ""
          },
          "lastName": {
            "type": "string",
            "title": "Lastname",
            "description": "User last name",
            "default": ""
          },
          "email": {
            "type": "string",
            "title": "Email",
            "description": "User email",
            "default": ""
          },
          "phone": {
            "type": "string",
            "title": "Phone",
            "description": "User phone number",
            "default": ""
          },
          "thread_id": {
            "type": "string",
            "title": "Thread Id",
            "description": "Optional chat thread ID",
            "default": ""
          }
        },
        "type": "object",
        "title": "LeadCreateRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
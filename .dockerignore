# chat-sdk is built separately; exclude its source from Docker build context.
# package.json is kept (negation rule) so npm ci can resolve the workspace.
packages/chat-sdk
!packages/chat-sdk/package.json

# Build artifacts (not needed in Docker build)
dist
dist-embed
*.pyc
*.tsbuildinfo

# Docs / non-runtime
docs
tools
examples
*.md
!apps/rag-api/app/services/instructions/*.md
!apps/rag-api/app/services/instructions.md
!apps/rag-api/price/*.md

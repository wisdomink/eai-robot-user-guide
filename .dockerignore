node_modules
.git
.gitignore
.pids
.logs
.env
.env.*
!.env.example

# Python
apps/rag-api/venv
apps/rag-api/__pycache__
apps/rag-api/**/__pycache__
apps/rag-api/.env
apps/rag-api/logs

# IDE / tools
.cursor

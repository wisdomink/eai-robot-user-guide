import { fileSearchTool, Agent, AgentInputItem, Runner, withTrace } from "@openai/agents";


// Tool definitions
const fileSearch = fileSearchTool([
  "vs_69a722dc52dc8191aea4f30fd977662f"
])
const ffMasterSupport = new Agent({
  name: "FF Master Support",
  instructions: `你是一名专业的技术支持工程师，专门负责 FF Master 系列机器人（FF Master / FF Master Edu / FF Master Ultra Edition）的用户支持。


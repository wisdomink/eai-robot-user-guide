# === OpenAI (required) ===
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-5

# === Chat Mode ===
# "backend"       → self-hosted ChatKit (openai-chatkit + openai-agents SDK)
# "agent-builder" → OpenAI-hosted Agent Builder workflow via ChatKit sessions
CHAT_MODE=backend
AGENT_BUILDER_WORKFLOW_ID=wf_69aa982ad2f4819098cf22592ff0d7d904a5dc09cc34613e

# === Vector Stores (per-product, required for backend mode) ===
OPENAI_VECTOR_STORE_MASTER_ULTRA_ID=vs_xxx
OPENAI_VECTOR_STORE_FUTURIST_ULTRA_ID=vs_xxx
OPENAI_VECTOR_STORE_AEGIS_ULTRA_ID=vs_xxx
OPENAI_VECTOR_STORE_AEGIS_EDU_ID=vs_xxx
OPENAI_VECTOR_STORE_ROBOT_ALL_ID=vs_xxx

# === Public URL (required for ChatKit image display in backend mode) ===
# ChatKit iframe hosted on cdn.platform.openai.com can't resolve relative
# image paths. Set this to your app's public origin.
PUBLIC_BASE_URL=https://your-domain.com

# === OpenAI (required) ===
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-5.4-mini

# === Vector Stores (per-product) ===
OPENAI_VECTOR_STORE_MASTER_ULTRA_ID=vs_xxx
OPENAI_VECTOR_STORE_FUTURIST_ULTRA_ID=vs_xxx
OPENAI_VECTOR_STORE_AEGIS_ULTRA_ID=vs_xxx
OPENAI_VECTOR_STORE_AEGIS_EDU_ID=vs_xxx
OPENAI_VECTOR_STORE_FF91_ID=vs_xxx
OPENAI_VECTOR_STORE_ROBOT_ALL_ID=vs_xxx

# === Logging ===
# LOG_DIR=/app/rag_server/logs
# LOG_LEVEL=INFO
# LOG_MAX_BYTES=10485760       # 10 MB per file
# LOG_BACKUP_COUNT=5           # keep 5 rotated backups

# === Smart Email Alerts (optional — rule-based error classification) ===
# Errors are classified into 4 categories:
#   alert   → Critical: send email immediately (auth, service down, OOM)
#   burst   → Important: only alert after N repeated failures in a window
#   suppress→ Known non-critical: silently ignore (warmup, 404s)
#   digest  → Default: accumulate and send periodic summary
ALERT_ENABLED=false
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USE_TLS=true
# ALERT_SMTP_USER=your-email@gmail.com
# ALERT_SMTP_PASSWORD=your-app-password
# ALERT_FROM_EMAIL=alerts@your-domain.com
# ALERT_TO_EMAILS=dev1@your-domain.com,dev2@your-domain.com
# ALERT_COOLDOWN_SECONDS=300   # same error suppressed for 5 minutes
# ALERT_CONTEXT_LINES=50       # recent log lines included in alert
# ALERT_LEVEL=ERROR            # minimum level: ERROR or CRITICAL
# ALERT_APP_NAME=EAI Robot
# ALERT_DIGEST_INTERVAL=3600   # digest summary email every 1 hour

# === Public URL (required for ChatKit image display in backend mode) ===
# ChatKit iframe hosted on cdn.platform.openai.com can't resolve relative
# image paths. Set this to your app's public origin.
PUBLIC_BASE_URL=https://your-domain.com

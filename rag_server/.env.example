# === OpenAI (required) ===
OPENAI_API_KEY=sk-your-openai-key-here

# Assistant ID (create via Dashboard or `python create_assistant.py`)
OPENAI_ASSISTANT_ID=asst_your-assistant-id-here

# Embedding model for vector search (used by ChromaDB)
EMBEDDING_MODEL=text-embedding-3-small

# === RAG Settings ===
SIMILARITY_TOP_K=5

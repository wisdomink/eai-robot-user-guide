# === OpenAI (required) ===
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_VECTOR_STORE_ID=vs_your-vector-store-id-here
LLM_MODEL=gpt-5

# === Public URL (required for ChatKit image display) ===
# ChatKit renders in an iframe from cdn.platform.openai.com, so relative
# image paths like /images/docx/xxx.png won't resolve to your server.
# Set this to your app's public origin so images load correctly.
PUBLIC_BASE_URL=https://your-domain.com
